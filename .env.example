# Required before a public launch. All values are public, never credentials.
# Defaults are documented in lib/site-config.ts.
NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_HELLO_EMAIL=
NEXT_PUBLIC_FOUNDER_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
# Set true for staging or Vercel preview deployments, false for production.
NEXT_PUBLIC_PREVIEW=true
